{
  "id": "echarts-test-case",
  "name": "ECharts 渲染测试案例",
  "template": {
    "unit": "mm",
    "paperSize": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 10,
      "right": 10,
      "bottom": 10,
      "left": 10
    },
    "header": {
      "height": 0,
      "elements": []
    },
    "footer": {
      "height": 0,
      "elements": []
    },
    "elements": [
      {
        "id": "etc-1",
        "type": "text",
        "options": {
          "left": 10,
          "top": 10,
          "width": 190,
          "height": 8,
          "fontSize": 14,
          "fontWeight": "bold",
          "textAlign": "center",
          "formatter": "{title}"
        },
        "printElementType": {
          "type": "text",
          "title": "文本"
        }
      },
      {
        "id": "etc-2",
        "type": "chart",
        "options": {
          "left": 10,
          "top": 22,
          "width": 90,
          "height": 78,
          "chartOption": {
            "grid": {
              "left": "12%",
              "right": "8%",
              "bottom": "14%",
              "top": "16%"
            },
            "title": {
              "text": "柱状图（销售额）",
              "left": "center",
              "top": 2,
              "textStyle": {
                "fontSize": 10
              }
            },
            "xAxis": {
              "type": "category",
              "data": [
                "$data"
              ]
            },
            "yAxis": {
              "type": "value"
            },
            "series": [
              {
                "type": "bar",
                "data": [
                  "$data"
                ],
                "name": "销售额",
                "itemStyle": {
                  "color": "#165dff"
                }
              }
            ]
          },
          "chartDataSource": "trend",
          "chartCategoryField": "name",
          "chartValueFields": [
            "sales"
          ]
        },
        "printElementType": {
          "type": "chart",
          "title": "图表"
        }
      },
      {
        "id": "etc-3",
        "type": "chart",
        "options": {
          "left": 110,
          "top": 22,
          "width": 90,
          "height": 78,
          "chartOption": {
            "grid": {
              "left": "12%",
              "right": "8%",
              "bottom": "14%",
              "top": "16%"
            },
            "title": {
              "text": "折线面积图（利润）",
              "left": "center",
              "top": 2,
              "textStyle": {
                "fontSize": 10
              }
            },
            "xAxis": {
              "type": "category",
              "data": [
                "$data"
              ]
            },
            "yAxis": {
              "type": "value"
            },
            "series": [
              {
                "type": "line",
                "data": [
                  "$data"
                ],
                "name": "利润",
                "smooth": true,
                "areaStyle": {},
                "itemStyle": {
                  "color": "#36b37e"
                }
              }
            ]
          },
          "chartDataSource": "trend",
          "chartCategoryField": "name",
          "chartValueFields": [
            "profit"
          ]
        },
        "printElementType": {
          "type": "chart",
          "title": "图表"
        }
      },
      {
        "id": "etc-4",
        "type": "chart",
        "options": {
          "left": 10,
          "top": 104,
          "width": 90,
          "height": 78,
          "chartOption": {
            "title": {
              "text": "饼图（占比）",
              "left": "center",
              "top": 2,
              "textStyle": {
                "fontSize": 10
              }
            },
            "tooltip": {
              "trigger": "item"
            },
            "series": [
              {
                "type": "pie",
                "data": [
                  "$data"
                ],
                "radius": "58%",
                "label": {
                  "fontSize": 9
                }
              }
            ]
          },
          "chartDataSource": "trend",
          "chartCategoryField": "name",
          "chartValueFields": [
            "sales"
          ]
        },
        "printElementType": {
          "type": "chart",
          "title": "图表"
        }
      },
      {
        "id": "etc-5",
        "type": "chart",
        "options": {
          "left": 110,
          "top": 104,
          "width": 90,
          "height": 78,
          "chartOption": {
            "grid": {
              "left": "12%",
              "right": "8%",
              "bottom": "14%",
              "top": "16%"
            },
            "title": {
              "text": "散点图",
              "left": "center",
              "top": 2,
              "textStyle": {
                "fontSize": 10
              }
            },
            "xAxis": {
              "type": "value",
              "name": "x",
              "nameTextStyle": {
                "fontSize": 9
              }
            },
            "yAxis": {
              "type": "value",
              "name": "y",
              "nameTextStyle": {
                "fontSize": 9
              }
            },
            "series": [
              {
                "type": "scatter",
                "data": [
                  "$data"
                ],
                "symbolSize": 10,
                "itemStyle": {
                  "color": "#ff7d00"
                }
              }
            ]
          },
          "chartDataSource": "scatter",
          "chartCategoryField": "x",
          "chartValueFields": [
            "y"
          ]
        },
        "printElementType": {
          "type": "chart",
          "title": "图表"
        }
      }
    ]
  },
  "data": {
    "title": "ECharts 渲染测试案例",
    "trend": [
      {
        "name": "一月",
        "sales": 120,
        "profit": 40
      },
      {
        "name": "二月",
        "sales": 168,
        "profit": 62
      },
      {
        "name": "三月",
        "sales": 145,
        "profit": 51
      },
      {
        "name": "四月",
        "sales": 200,
        "profit": 88
      },
      {
        "name": "五月",
        "sales": 230,
        "profit": 102
      }
    ],
    "scatter": [
      {
        "x": 10,
        "y": 20
      },
      {
        "x": 25,
        "y": 35
      },
      {
        "x": 40,
        "y": 55
      },
      {
        "x": 55,
        "y": 48
      },
      {
        "x": 70,
        "y": 78
      },
      {
        "x": 85,
        "y": 92
      }
    ]
  }
}
