{
  "id": "sales-chart",
  "name": "销售趋势图表",
  "template": {
    "unit": "mm",
    "paperSize": "A4",
    "orientation": "portrait",
    "margins": {
      "top": 10,
      "right": 10,
      "bottom": 10,
      "left": 10
    },
    "header": {
      "height": 0,
      "elements": []
    },
    "footer": {
      "height": 0,
      "elements": []
    },
    "elements": [
      {
        "id": "chart-1",
        "type": "text",
        "options": {
          "left": 45,
          "top": 10,
          "width": 100,
          "height": 8,
          "fontSize": 14,
          "fontWeight": "bold",
          "textAlign": "center",
          "formatter": "{title}"
        },
        "printElementType": {
          "type": "text",
          "title": "文本"
        }
      },
      {
        "id": "chart-2",
        "type": "chart",
        "options": {
          "left": 45,
          "top": 22,
          "width": 100,
          "height": 60,
          "chartOption": {
            "grid": {
              "left": "8%",
              "right": "8%",
              "bottom": "12%",
              "top": "18%"
            },
            "xAxis": {
              "type": "category",
              "data": [
                "$data"
              ]
            },
            "yAxis": {
              "type": "value"
            },
            "series": [
              {
                "type": "bar",
                "data": [
                  "$data"
                ],
                "name": "销售额（万元）"
              }
            ]
          },
          "chartDataSource": "trend",
          "chartCategoryField": "name",
          "chartValueFields": [
            "sales"
          ]
        },
        "printElementType": {
          "type": "chart",
          "title": "图表"
        }
      },
      {
        "id": "chart-3",
        "type": "chart",
        "options": {
          "left": 45,
          "top": 92,
          "width": 100,
          "height": 60,
          "chartOption": {
            "tooltip": {
              "trigger": "item"
            },
            "series": [
              {
                "type": "pie",
                "data": [
                  "$data"
                ],
                "radius": "62%"
              }
            ]
          },
          "chartDataSource": "trend",
          "chartCategoryField": "name",
          "chartValueFields": [
            "sales"
          ]
        },
        "printElementType": {
          "type": "chart",
          "title": "图表"
        }
      }
    ]
  },
  "data": {
    "title": "2026 年一季度销售趋势",
    "trend": [
      {
        "name": "1 月",
        "sales": 120
      },
      {
        "name": "2 月",
        "sales": 168
      },
      {
        "name": "3 月",
        "sales": 145
      }
    ]
  }
}
