node_modules/
dist/
out/

# macOS 目录元数据
.DS_Store

# demo 联调字体二进制：三款 OFL 固定测试字体入库（来源见 demo/public/fonts/README.md），其余自定义测试字体不入库
demo/public/fonts/*
!demo/public/fonts/MaShanZheng-Regular.ttf
!demo/public/fonts/ZCOOLKuaiLe-Regular.ttf
!demo/public/fonts/ZCOOLQingKeHuangYou-Regular.ttf

# 教学视频流水线（录屏脚本 + 剧本 + 成品）：作者本地私有工具链，整目录不入库
.video/

# AI 生成图片临时目录，不入库
vibe_images/

# print-common 从 canvas 派生的构建输入（npm run styles 生成，不入库）
packages/print-common/src/styles/designer.css
packages/print-common/src/core/icons.ts

# demo-common 验收产物（verify-demo.mjs 每次跑都会重新截图）
demo-common/evidence/

# demo-common 子工程直挂资产：npm install 的 postinstall 从 @worm-vue3-print/common 的 dist 拷来
demo-common/apps/*/public/vendor/
demo-common/apps/*/dist/

# demo-common 子工程的示例字体：sync-demo-samples.mjs 从 demo/public/fonts 拷来，单个 1.5~8MB 不入库
demo-common/apps/*/public/fonts/
