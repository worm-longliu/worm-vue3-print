{
  "unit": "mm",
  "paperSize": "THERMAL_80",
  "orientation": "portrait",
  "margins": {
    "top": 3,
    "right": 2,
    "bottom": 3,
    "left": 2
  },
  "header": {
    "height": 0,
    "elements": []
  },
  "footer": {
    "height": 0,
    "elements": []
  },
  "firstPageOverlay": {
    "height": 0,
    "elements": []
  },
  "watermark": {},
  "elements": [
    {
      "id": "rc-1",
      "type": "text",
      "options": {
        "left": 0,
        "top": 0,
        "width": 76,
        "height": 6,
        "formatter": "{store.name}",
        "fontSize": 14,
        "fontWeight": "bold",
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-2",
      "type": "text",
      "options": {
        "left": 0,
        "top": 6,
        "width": 76,
        "height": 4,
        "formatter": "{store.address}",
        "fontSize": 8,
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-3",
      "type": "text",
      "options": {
        "left": 0,
        "top": 10,
        "width": 76,
        "height": 4,
        "formatter": "服务热线：{store.tel}",
        "fontSize": 8,
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-4",
      "type": "hline",
      "options": {
        "left": 0,
        "top": 14.5,
        "width": 76,
        "height": 0.2,
        "borderWidth": 0.4,
        "borderColor": "#999999"
      },
      "printElementType": {
        "type": "hline",
        "title": "横线"
      }
    },
    {
      "id": "rc-5",
      "type": "text",
      "options": {
        "left": 0,
        "top": 15.5,
        "width": 44,
        "height": 4,
        "formatter": "单号：{order.no}",
        "fontSize": 8,
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-6",
      "type": "text",
      "options": {
        "left": 44,
        "top": 15.5,
        "width": 32,
        "height": 4,
        "formatter": "收银员：{order.cashier}",
        "fontSize": 8,
        "textAlign": "right",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-7",
      "type": "text",
      "options": {
        "left": 0,
        "top": 19.5,
        "width": 76,
        "height": 4,
        "formatter": "交易时间：{order.time}",
        "fontSize": 8,
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-8",
      "type": "hline",
      "options": {
        "left": 0,
        "top": 24,
        "width": 76,
        "height": 0.2,
        "borderWidth": 0.4,
        "borderColor": "#999999"
      },
      "printElementType": {
        "type": "hline",
        "title": "横线"
      }
    },
    {
      "id": "rc-12",
      "type": "table",
      "options": {
        "left": 0,
        "top": 25.5,
        "width": 76,
        "height": 17.5,
        "tableMode": "dynamic",
        "dataSource": "items",
        "tableColWidths": [
          38,
          12,
          13,
          13
        ],
        "tableDefaultFontSize": 8,
        "tableDefaultPadding": 0.8,
        "tablePagination": {
          "enabled": true
        },
        "tableRows": [
          {
            "id": "row-rc-9",
            "type": "header",
            "height": 6,
            "cells": [
              {
                "id": "cell-rc-9-1",
                "formatter": "商品",
                "align": "left",
                "fontWeight": "bold"
              },
              {
                "id": "cell-rc-9-2",
                "formatter": "数量",
                "align": "right",
                "fontWeight": "bold"
              },
              {
                "id": "cell-rc-9-3",
                "formatter": "单价",
                "align": "right",
                "fontWeight": "bold"
              },
              {
                "id": "cell-rc-9-4",
                "formatter": "金额",
                "align": "right",
                "fontWeight": "bold"
              }
            ]
          },
          {
            "id": "row-rc-10",
            "type": "data",
            "height": 5.5,
            "cells": [
              {
                "id": "cell-rc-10-1",
                "formatter": "{items.name}",
                "align": "left"
              },
              {
                "id": "cell-rc-10-2",
                "formatter": "{items.qty}",
                "align": "right"
              },
              {
                "id": "cell-rc-10-3",
                "formatter": "{MONEY(items.price)}",
                "align": "right"
              },
              {
                "id": "cell-rc-10-4",
                "formatter": "{MONEY(items.amount)}",
                "align": "right"
              }
            ]
          },
          {
            "id": "row-rc-11",
            "type": "summary",
            "height": 6,
            "cells": [
              {
                "id": "cell-rc-11-1",
                "formatter": "合计",
                "align": "left",
                "fontWeight": "bold"
              },
              {
                "id": "cell-rc-11-2",
                "formatter": "{SUM(items.qty)}",
                "align": "right",
                "fontWeight": "bold"
              },
              {
                "id": "cell-rc-11-3",
                "formatter": "",
                "align": "right"
              },
              {
                "id": "cell-rc-11-4",
                "formatter": "{MONEY(SUM(items.amount))}",
                "align": "right",
                "fontWeight": "bold"
              }
            ]
          }
        ]
      },
      "printElementType": {
        "type": "table",
        "title": "表格"
      }
    },
    {
      "id": "rc-13",
      "type": "text",
      "options": {
        "left": 0,
        "top": 45,
        "width": 76,
        "height": 4,
        "formatter": "支付方式：{order.payMethod}",
        "fontSize": 8.5,
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-14",
      "type": "text",
      "options": {
        "left": 0,
        "top": 49,
        "width": 76,
        "height": 4,
        "formatter": "实付：¥{MONEY(order.paid)}    找零：¥{MONEY(order.change)}",
        "fontSize": 8.5,
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-15",
      "type": "text",
      "options": {
        "left": 0,
        "top": 53,
        "width": 76,
        "height": 4,
        "formatter": "会员卡号：{order.memberNo}    本次积分：{order.points}",
        "fontSize": 8,
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-16",
      "type": "hline",
      "options": {
        "left": 0,
        "top": 57.5,
        "width": 76,
        "height": 0.2,
        "borderWidth": 0.4,
        "borderColor": "#999999"
      },
      "printElementType": {
        "type": "hline",
        "title": "横线"
      }
    },
    {
      "id": "rc-17",
      "type": "qrcode",
      "options": {
        "left": 26,
        "top": 59,
        "width": 24,
        "height": 24,
        "formatter": "{order.qrcode}",
        "qrCodeLevel": "M"
      },
      "printElementType": {
        "type": "qrcode",
        "title": "二维码"
      }
    },
    {
      "id": "rc-18",
      "type": "text",
      "options": {
        "left": 0,
        "top": 84,
        "width": 76,
        "height": 5,
        "formatter": "谢谢惠顾，欢迎下次光临！",
        "fontSize": 10,
        "fontWeight": "bold",
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-19",
      "type": "text",
      "options": {
        "left": 0,
        "top": 89,
        "width": 76,
        "height": 4,
        "formatter": "小票号 {order.no}   {order.time}",
        "fontSize": 7.5,
        "color": "#666666",
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    },
    {
      "id": "rc-20",
      "type": "text",
      "options": {
        "left": 0,
        "top": 93,
        "width": 76,
        "height": 4,
        "formatter": "凭此小票 7 日内可办理退换货",
        "fontSize": 7,
        "color": "#999999",
        "textAlign": "center",
        "verticalAlign": "middle"
      },
      "printElementType": {
        "type": "text",
        "title": "文本"
      }
    }
  ]
}
