{
  "name": "@worm-vue3-print/demo",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "description": "打印模板设计器使用示例（加载真实模板 106977040967000141）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "video:voice": "node video/voiceover.mjs",
    "video:cover": "node video/cover.mjs",
    "video:record": "node video/record.mjs",
    "video:compose": "node video/compose.mjs",
    "video:check": "node video/check-sync.mjs",
    "video": "npm run video:voice && npm run video:cover && npm run video:record && npm run video:compose",
    "video:expression": "VIDEO_SCRIPT=script-expression.json npm run video",
    "video:group": "VIDEO_SCRIPT=script-group.json npm run video",
    "video:toolbar": "VIDEO_SCRIPT=script-toolbar.json npm run video",
    "video:portrait:voice": "node video/portrait/voice.mjs",
    "video:portrait:cards": "node video/portrait/cards.mjs",
    "video:portrait:compose": "node video/portrait/compose.mjs",
    "video:portrait:check": "node video/portrait/check-layout.mjs",
    "video:portrait:subs": "node video/portrait/check-subs.mjs",
    "video:portrait": "npm run video:portrait:voice && npm run video:portrait:cards && npm run video:portrait:check && npm run video:portrait:compose && npm run video:portrait:subs"
  },
  "dependencies": {
    "@worm-vue3-print/canvas": "file:../packages/print-canvas",
    "@worm-vue3-print/core": "file:../packages/print-core",
    "dompurify": "^3.4.12",
    "jsbarcode": "^3.12.3",
    "lucide-vue-next": "^0.577.0",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.5",
    "vue-tsc": "^3.1.4"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/darwin-x64": "^4.1.0",
    "@ffprobe-installer/darwin-x64": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
