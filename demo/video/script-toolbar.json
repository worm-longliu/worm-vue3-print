        { "do": "click", "selector": "[data-test=\"border-panel\"] [data-test=\"preset-all\"]", "s": 2, "ms": 900 },
        { "do": "hover", "selector": "[data-test=\"border-panel\"] [data-test=\"preset-outer\"]", "s": 3, "ms": 1100 },
