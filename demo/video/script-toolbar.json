        { "do": "click", "selector": "[data-test=\"view-panel\"] button[data-tip=\"显示/隐藏标尺\"]", "ms": 900 },
        { "do": "click", "selector": "[data-test=\"view-panel\"] button[data-tip=\"显示/隐藏网格背景\"]", "s": 2, "ms": 1000 },
