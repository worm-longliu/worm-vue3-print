        { "do": "hover", "selector": "[data-test=\"arrange-panel\"] button[data-tip=\"置顶\"]", "s": 10, "ms": 800 },
        { "do": "hover", "selector": "[data-test=\"arrange-panel\"] button[data-tip=\"置底\"]", "ms": 800 },
        { "do": "hover", "selector": "[data-test=\"arrange-panel\"] button[data-tip=\"上移一层\"]", "ms": 700 },
