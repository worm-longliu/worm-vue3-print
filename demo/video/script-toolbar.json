        { "do": "hover", "selector": ".format-toolbar .ft-color-btn >> nth=1", "s": 3, "ms": 1400 },
        { "do": "click", "selector": ".format-toolbar .ft-color-btn .preset-color-trigger >> nth=1", "s": 4, "ms": 700 },
        { "do": "click", "selector": ".preset-color-item >> nth=4", "ms": 800 },
        { "do": "click", "selector": ".designer-toolbar .tb-title", "ms": 600 }
      ]
    },
    {
      "name": "撤销与重做实战",
      "voiceover": "到这里我们改了字号、加粗、下划线、删除线和两个颜色，该撤销登场了。点一下撤销，最后应用的浅灰底色先消失。继续点，字色、删除线、下划线逐条退回去。点重做，它们又按正序回来。日常用 Ctrl 加 Z 和 Ctrl 加 Y 快捷键同样顺手。想推倒重来，刷新页面就能回到初始模板。",
      "steps": [
        { "do": "click", "selector": ".designer-toolbar button[data-tip=\"撤销\"]", "s": 1, "ms": 900 },
        { "do": "click", "selector": ".designer-toolbar button[data-tip=\"撤销\"]", "s": 2, "ms": 800 },
        { "do": "click", "selector": ".designer-toolbar button[data-tip=\"撤销\"]", "ms": 800 },
        { "do": "click", "selector": ".designer-toolbar button[data-tip=\"撤销\"]", "ms": 800 },
        { "do": "click", "selector": ".designer-toolbar button[data-tip=\"重做\"]", "s": 3, "ms": 900 },
        { "do": "click", "selector": ".designer-toolbar button[data-tip=\"重做\"]", "ms": 900 },
        { "do": "key", "keys": "Mod+z", "s": 4, "ms": 800 },
        { "do": "reload", "ms": 1500, "s": 5 }
