{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@worm-vue3-print/canvas": ["../packages/print-common/src/vue3/index.ts"],
      "@worm-vue3-print/common/vue3": ["../packages/print-common/src/vue3/index.ts"],
      "@worm-vue3-print/common": ["../packages/print-common/src/index.ts"],
      "@worm-vue3-print/plugin-kit": ["../packages/print-plugin-kit/src/index.ts"],
      "@worm-vue3-print/echarts-common": ["../packages/print-echarts-common/src/index.ts"],
      "@worm-vue3-print/echarts/kit": ["../packages/print-echarts/src/kit.ts"],
      "@worm-vue3-print/core": ["../packages/print-core/src/index.ts"],
      "@worm-vue3-print/echarts": ["../packages/print-echarts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ]
}