{
  "name": "@worm-vue3-print/canvas",
  "version": "1.2.2",
  "type": "module",
  "description": "Vue 3 可视化打印模板设计器画布（开源核心，无 Element Plus、无宿主业务依赖）",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/canvas.css"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "vue3",
    "print",
    "template",
    "designer",
    "canvas"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && vue-tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@worm-vue3-print/core": "^1.0.0",
    "dompurify": "^3.4.12",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "vue": "^3.5.24",
    "vue-tsc": "^3.3.11"
  }
}
