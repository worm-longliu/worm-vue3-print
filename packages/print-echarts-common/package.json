{
  "name": "@worm-vue3-print/echarts-common",
  "version": "1.5.0",
  "type": "module",
  "description": "【尚未发布】ECharts 图表元素的 common 宿主适配包：以 @worm-vue3-print/plugin-kit 契约提供静态 SVG 画布与图形化属性面板，供零框架设计器直接使用",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "worm <liu_long_qqcom@qq.com>",
  "homepage": "https://github.com/worm-longliu/worm-print-platform",
  "bugs": {
    "url": "https://github.com/worm-longliu/worm-print-platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/liulong_oschina/worm-vue3-print.git"
  },
  "keywords": [
    "print",
    "template",
    "echarts",
    "chart",
    "common",
    "plugin"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/inject-license-banner.mjs dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@worm-vue3-print/core": "^1.5.0",
    "@worm-vue3-print/echarts": "^1.5.0",
    "@worm-vue3-print/plugin-kit": "^1.5.0"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "vitest": "^1.6.0"
  }
}
