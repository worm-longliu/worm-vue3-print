{
  "name": "@worm-vue3-print/common",
  "version": "1.3.5",
  "type": "module",
  "description": "【实验性，不建议用于生产】打印模板设计器的通用宿主适配包：任意框架或无框架宿主均可直接接入（实现为零框架原生 Custom Elements + Shadow DOM），零 Vue/React 依赖，直接消费 @worm-vue3-print/core；Vue 3 项目请使用 @worm-vue3-print/canvas",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser-bundle.d.ts",
      "default": "./dist/common.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "worm <liu_long_qqcom@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/liulong_oschina/worm-vue3-print.git"
  },
  "readme": "README.md",
  "keywords": [
    "print",
    "template",
    "designer",
    "web-components",
    "custom-elements",
    "framework-agnostic"
  ],
  "scripts": {
    "styles": "node scripts/gen-styles.mjs && node scripts/gen-icons.mjs",
    "build": "npm run styles && vite build && vite build -c vite.bundle.config.ts && tsc -p tsconfig.build.json && node ../../scripts/inject-license-banner.mjs dist",
    "dev": "npm run styles && vite build --watch",
    "typecheck": "npm run styles && tsc -p tsconfig.json --noEmit",
    "test": "npm run styles && vitest run"
  },
  "dependencies": {
    "@worm-vue3-print/core": "^1.3.5",
    "dompurify": "^3.4.12",
    "jsbarcode": "^3.12.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "happy-dom": "^20.10.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^1.6.0"
  }
}
